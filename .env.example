# Required: pre-event OpenStreetMap via the ohsome API (free key: https://account.heigit.org/signup)
OHSOME_API_KEY=...

# Optional: fallback Sentinel-1 provider
MERU_BASE_URL=https://app.merulabs.space
MERU_API_KEY=meru_sk_...

# Optional: language models. Without one, the copilot uses its offline deterministic router and the
# inspector its rule planner. First configured wins, or pick with WATERGUARD_LLM=nebius|openai|bedrock|offline.
#
# NVIDIA Nemotron on Nebius Token Factory (https://tokenfactory.nebius.com)
# NEBIUS_API_KEY=...
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b            # copilot
# NEBIUS_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b    # inspector planner (--planner llm)
# NEBIUS_VL_MODEL=nvidia/Nemotron-3.5-Super-VL              # inspector second look at the analyst chip
#
# Amazon Bedrock (AWS credentials from the environment or instance role)
# BEDROCK_MODEL=apac.amazon.nova-pro-v1:0
# AWS_REGION=ap-south-1
#
# Any other OpenAI-compatible endpoint
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# OPENAI_MODEL=...

# Optional: web reports in the copilot (news and agency reports after the event; never an input to the maps)
# TAVILY_API_KEY=tvly-...

# Who is counted on the map (exposure.py): open = OSM + Google/Microsoft open building footprints + WorldPop
# population (default); osm = OSM buildings x 4.37 persons per household
# WATERGUARD_EXPOSURE=open

# Public-server limits
# WATERGUARD_MAX_QUEUE=4              # runs + inspections waiting or running
# WATERGUARD_WEB_PER_HOUR=60          # uncached web searches
# WATERGUARD_ALLOW_LLM_PLANNER=1      # let visitors pick the model planner for an inspection (costs tokens)
# WATERGUARD_READONLY_REVIEW=1        # analysts' Keep/Remove disabled (public demo)
