# Required: pre-event OpenStreetMap via the ohsome API (free key: https://account.heigit.org/signup)
OHSOME_API_KEY=...

# Optional: fallback Sentinel-1 provider
MERU_BASE_URL=https://app.merulabs.space
MERU_API_KEY=meru_sk_...

# Optional: copilot LLM. Without one, the copilot uses its offline deterministic router.
# WATERGUARD_LLM=bedrock            # bedrock | openai | offline
# BEDROCK_MODEL=apac.amazon.nova-pro-v1:0
# AWS_REGION=ap-south-1
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.studio.nebius.com/v1/
# OPENAI_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
